      "required": [
        "offer_id",
        "score",
        "intent_match",
        "budget_fit",
        "date_fit",
        "companion_fit",
        "source_confidence"
      ],
      "title": "RankingExplanation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collection_id": {
      "title": "Collection Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "currency": {
      "const": "EUR",
