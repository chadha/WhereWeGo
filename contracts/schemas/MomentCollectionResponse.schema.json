        },
        "relevance_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Score"
        }
      },
      "required": [
        "provider",
        "retrieved_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
