        "date_fit": {
          "title": "Date Fit",
          "type": "number"
        },
        "companion_fit": {
          "title": "Companion Fit",
          "type": "number"
        },
        "source_confidence": {
          "title": "Source Confidence",
          "type": "number"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
