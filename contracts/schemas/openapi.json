{
  "openapi": "3.1.0",
  "info": {
    "title": "Moment Intelligence API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live V1 Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "type": "object",
                  "title": "Response Ready V1 Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/summary": {
      "get": {
        "summary": "Demo Summary",
        "description": "Aggregate local demo numbers. Disable with DEMO_SUMMARY_ENABLED=false outside demos.",
        "operationId": "demo_summary_v1_demo_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSummary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/discover": {
      "post": {
        "summary": "Discover",
        "operationId": "discover_v1_discover_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentCollectionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{collection_id}": {
      "get": {
        "summary": "Get Collection",
        "operationId": "get_collection_v1_collections__collection_id__get",
        "parameters": [
          {
            "name": "collection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Collection Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MomentCollectionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/offers/{offer_id}": {
      "get": {
        "summary": "Get Offer",
        "operationId": "get_offer_v1_offers__offer_id__get",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Offer Id"
            }
          },
          {
            "name": "collection_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Collection Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Offer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Record Event",
        "operationId": "record_event_v1_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Record Event V1 Events Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/offers/{offer_id}/go": {
      "get": {
        "summary": "Go To Offer",
        "description": "Record offer_clicked and redirect to the stored source URL (no open redirect).",
        "operationId": "go_to_offer_v1_offers__offer_id__go_get",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Offer Id"
            }
          },
          {
            "name": "collection_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Collection Id"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Budget": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "const": "EUR",
            "title": "Currency",
            "default": "EUR"
          },
          "scope": {
            "type": "string",
            "enum": [
              "per_person",
              "total"
            ],
            "title": "Scope",
            "default": "total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "Budget"
      },
      "ClientEventRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_\\-\\.]+$",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "offer_viewed",
              "offer_clicked",
              "collection_viewed"
            ],
            "title": "Event Type"
          },
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_\\-\\.]+$",
            "title": "Session Id"
          },
          "collection_id": {
            "type": "string",
            "title": "Collection Id"
          },
          "offer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offer Id"
          },
          "source": {
            "$ref": "#/components/schemas/EventSource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "session_id",
          "collection_id"
        ],
        "title": "ClientEventRequest",
        "description": "Events the frontend may send. Server-side events are emitted by the API itself."
      },
      "CollectionExplanation": {
        "properties": {
          "matched_preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Preferences"
          },
          "ranking": {
            "items": {
              "$ref": "#/components/schemas/RankingExplanation"
            },
            "type": "array",
            "title": "Ranking"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CollectionExplanation"
      },
      "Consent": {
        "properties": {
          "analytics": {
            "type": "boolean",
            "title": "Analytics",
            "default": false
          },
          "marketing": {
            "type": "boolean",
            "title": "Marketing",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Consent"
      },
      "Constraints": {
        "properties": {
          "indoor_preferred": {
            "type": "boolean",
            "title": "Indoor Preferred",
            "default": false
          },
          "max_travel_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 240.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Travel Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Constraints"
      },
      "DateWindow": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "flexible": {
            "type": "boolean",
            "title": "Flexible",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "DateWindow"
      },
      "DemoSummary": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "discoveries": {
            "type": "integer",
            "title": "Discoveries"
          },
          "ok": {
            "type": "integer",
            "title": "Ok"
          },
          "no_results": {
            "type": "integer",
            "title": "No Results"
          },
          "degraded": {
            "type": "integer",
            "title": "Degraded"
          },
          "offers_shown": {
            "type": "integer",
            "title": "Offers Shown"
          },
          "offer_views": {
            "type": "integer",
            "title": "Offer Views"
          },
          "offer_clicks": {
            "type": "integer",
            "title": "Offer Clicks"
          },
          "click_through_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Click Through Rate"
          },
          "events_recorded": {
            "type": "integer",
            "title": "Events Recorded"
          },
          "events_dropped_without_consent": {
            "type": "integer",
            "title": "Events Dropped Without Consent"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "discoveries",
          "ok",
          "no_results",
          "degraded",
          "offers_shown",
          "offer_views",
          "offer_clicks",
          "click_through_rate",
          "events_recorded",
          "events_dropped_without_consent",
          "note",
          "generated_at"
        ],
        "title": "DemoSummary"
      },
      "DiscoveryRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_\\-\\.]+$",
            "title": "Request Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_\\-\\.]+$",
            "title": "Session Id"
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Locale",
            "default": "en-DE"
          },
          "city": {
            "type": "string",
            "maxLength": 60,
            "minLength": 2,
            "pattern": "^[\\w .'\\-]+$",
            "title": "City"
          },
          "companion": {
            "type": "string",
            "enum": [
              "partner",
              "family",
              "friends",
              "solo",
              "colleagues"
            ],
            "title": "Companion"
          },
          "desired_feelings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Desired Feelings"
          },
          "occasion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[\\w .'\\-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occasion"
          },
          "date_window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DateWindow"
              },
              {
                "type": "null"
              }
            ]
          },
          "budget": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Budget"
              },
              {
                "type": "null"
              }
            ]
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "session_id",
          "city",
          "companion"
        ],
        "title": "DiscoveryRequest"
      },
      "EventSource": {
        "properties": {
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          },
          "utm_source": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Source"
          },
          "utm_medium": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Medium"
          },
          "utm_campaign": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Utm Campaign"
          },
          "referrer_domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Referrer Domain"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EventSource"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Location"
      },
      "MomentCollectionResponse": {
        "properties": {
          "collection_id": {
            "type": "string",
            "title": "Collection Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "currency": {
            "type": "string",
            "const": "EUR",
            "title": "Currency",
            "default": "EUR"
          },
          "estimated_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Total"
          },
          "price_status": {
            "type": "string",
            "enum": [
              "unknown",
              "illustrative",
              "estimated",
              "verified"
            ],
            "title": "Price Status"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers"
          },
          "explanation": {
            "$ref": "#/components/schemas/CollectionExplanation"
          },
          "availability_status": {
            "type": "string",
            "enum": [
              "not_verified",
              "verified"
            ],
            "title": "Availability Status",
            "default": "not_verified"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_results",
              "degraded"
            ],
            "title": "Status"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "data_source": {
            "type": "string",
            "enum": [
              "tavily_search",
              "demo_catalogue",
              "provider_api"
            ],
            "title": "Data Source"
          },
          "excluded_offers": {
            "type": "integer",
            "title": "Excluded Offers",
            "default": 0
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "collection_id",
          "request_id",
          "title",
          "description",
          "price_status",
          "offers",
          "explanation",
          "status",
          "data_source",
          "generated_at"
        ],
        "title": "MomentCollectionResponse"
      },
      "Offer": {
        "properties": {
          "offer_id": {
            "type": "string",
            "title": "Offer Id"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "unknown"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "suitable_for": {
            "items": {
              "type": "string",
              "enum": [
                "partner",
                "family",
                "friends",
                "solo",
                "colleagues"
              ]
            },
            "type": "array",
            "title": "Suitable For"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "source_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Title"
          },
          "affiliate_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Affiliate Url"
          },
          "availability_status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ],
            "title": "Availability Status",
            "default": "unknown"
          },
          "last_verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Verified At"
          },
          "data_source": {
            "type": "string",
            "enum": [
              "tavily_search",
              "demo_catalogue",
              "provider_api"
            ],
            "title": "Data Source"
          },
          "is_illustrative": {
            "type": "boolean",
            "title": "Is Illustrative"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "offer_id",
          "provider_id",
          "title",
          "description",
          "data_source",
          "is_illustrative",
          "provenance"
        ],
        "title": "Offer"
      },
      "Price": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "const": "EUR"
              },
              {
                "type": "null"
              }
