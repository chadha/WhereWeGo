# Copy to .env (never commit .env). The API reads these from the environment.
# Without TAVILY_API_KEY the local demo catalogue is used.
TAVILY_API_KEY=
PROVIDER_MODE=auto            # auto | tavily | mock
TAVILY_TIMEOUT_SECONDS=8
TAVILY_MAX_RETRIES=2          # capped at 3
TAVILY_MAX_RESULTS=5          # capped at 5
DISCOVERY_TIMEOUT_SECONDS=20
DISCOVER_RATE_LIMIT_PER_MINUTE=30
DATABASE_URL=sqlite:///./wherewego-local.db   # or postgresql+psycopg://... (docker compose)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEMO_SUMMARY_ENABLED=true     # local demos only
MODEL_GATEWAY=mock            # mock | bedrock
BEDROCK_ENABLED=false         # requires explicit approval (ADR-010)
# Approved affiliate partners (ADR-013). Leave empty until a programme has accepted us:
# empty means no link is ever tagged. JSON list on one line; take the parameter names
# and your ID from the partner dashboard, never guess them. Keep the single quotes
# (run_local.sh reads this file with bash). Shape:
# AFFILIATE_RULES='[{"domain":"partner.example","params":{"partner_id":"YOUR_ID"},"click_id_param":"cmp"}]'
AFFILIATE_RULES=
